    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
