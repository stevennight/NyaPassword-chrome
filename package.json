{
  "name": "nyapassword-chrome",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "description": "NyaPassword browser extension for Chrome and Edge (Manifest V3)",
  "scripts": {
    "wasm": "npm --prefix ../common/web run wasm",
